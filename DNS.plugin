#!name=🍟 Loon DNS Enhanced Ultimate
#!desc=基于当前Loon DNS架构的精简分流：国内DoH/海外DoH/Apple/YouTube/AI/开发/社交/流媒体/IPv6/DNS劫持
#!author=ChatGPT
#!category=🍟 Fries
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Server.png
#!loon_version=3.2.5(789)


[General]

# ============================================================
# 默认 DNS
#
# Loon 当前语法：
# dns-server  = UDP DNS
# doh-server  = DNS over HTTPS
#
# 默认使用国内 DoH。
# ============================================================

doh-server = https://dns.alidns.com/dns-query,https://doh.pub/dns-query



# ============================================================
# IPv4 / IPv6
#
# ipv6 已在 Loon 3.2.3+ 弃用。
# dual：
# 同时查询 A / AAAA，并根据响应速度选择。
# ============================================================

ip-mode = dual


# ---------- Fake-IP 与防泄漏 ----------
# 这些域名返回真实 IP，避免系统缓存 Fake-IP 导致关闭 Loon 后异常
real-ip = *.apple.com,*.icloud.com,*.mzstatic.com,localhost,*.local,*.lan,*.arpa,router.*,*.home


# ============================================================
# DNS 劫持
#
# 3.2.5 (build 789+) 支持。
# 用于拦截 App 自己发起的 UDP/53 DNS 查询，
# 防止 App 绕过 Loon 使用自定义 DNS。
# ============================================================

hijack-dns = *:53



[Host]


# ============================================================
# Localhost
# ============================================================

localhost = server:system
localhost.localdomain = server:system

ip6-localhost = ::1
ip6-loopback = ::1


# ============================================================
# Router / LAN
#
# 本地路由器/设备管理域名交给系统 DNS。
# ============================================================

router.asus.com = server:system
routerlogin.net = server:system
orbilogin.com = server:system

tplinkwifi.net = server:system
tplinklogin.net = server:system
tplogin.cn = server:system

miwifi.com = server:system
www.miwifi.com = server:system

mediarouter.home = server:system

melogin.cn = server:system
falogin.cn = server:system

tendawifi.com = server:system
zte.home = server:system
hiwifi.com = server:system

p.to = server:system

amplifi.lan = server:system
unifi.local = server:system


# ============================================================
# Private Network
# ============================================================

home.arpa = server:system
local = server:system



# ============================================================
# Apple
#
# Apple 官方 DoH
# ============================================================

networking.apple = server:https://doh.dns.apple.com/dns-query

*.apple.com = server:https://doh.dns.apple.com/dns-query

*.icloud.com = server:https://doh.dns.apple.com/dns-query

*.mzstatic.com = server:https://doh.dns.apple.com/dns-query



# ============================================================
# Google / YouTube
#
# 不再把整个 Google 域名空间全部交给 Google DNS。
# 只处理实际与 YouTube / 视频 CDN 相关的域名。
# ============================================================

*.youtube.com = server:https://dns.google/dns-query

*.youtube-nocookie.com = server:https://dns.google/dns-query

*.googlevideo.com = server:https://dns.google/dns-query

*.ytimg.com = server:https://dns.google/dns-query



